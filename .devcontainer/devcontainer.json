{
  "name": "User Management (Java 21 + SQL Server)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "installMaven": "true"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-boot-dev-pack",
        "ms-mssql.mssql"
      ]
    }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "User Management app", "onAutoForward": "notify" }
  }
}
